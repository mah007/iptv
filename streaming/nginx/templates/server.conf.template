# Rendered by docker-entrypoint.d/40-edge-config.sh into /etc/nginx/conf.d/edge/ from
# EDGE_* variables. Edit the template, not the rendered copy. The script appends the
# trusted-proxy (real IP) directives when EDGE_REAL_IP_FROM is set.

# nginx ends every request-scoped error line with the raw request line, which holds
# the token, so the default level (emerg) keeps them out of the logs altogether. The
# JSON access log carries the operational signal (status, verdict, auth_status).
# Raise the level only while debugging, and treat that output as sensitive.
error_log /dev/stderr ${EDGE_REQUEST_ERROR_LOG_LEVEL};

# stream-auth: Django's heartbeat and kick check (ADR-0007). A 204 is cached per
# token for EDGE_AUTH_CACHE_TTL. A 403 or an error is never cached and a stale answer
# is never served (no use_stale, no background update), so a kick or an expired
# subscription takes effect within one TTL, and the edge fails closed when Django
# is unreachable.
location = /_auth {
    internal;
    proxy_pass http://edge_auth/internal/stream-auth;
    proxy_pass_request_body off;
    proxy_pass_request_headers off;
    proxy_set_header Host ${EDGE_AUTH_HOST};
    proxy_set_header Content-Length "";
    proxy_set_header Connection "";
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Request-ID $edge_request_id;
    proxy_set_header X-Edge-Id $edge_id;
    proxy_http_version 1.1;
    proxy_connect_timeout 2s;
    proxy_send_timeout 5s;
    proxy_read_timeout 5s;

    proxy_cache edge_auth;
    proxy_cache_key $edge_auth_key;
    proxy_cache_valid 204 ${EDGE_AUTH_CACHE_TTL};
    proxy_cache_lock on;
    proxy_cache_lock_timeout 5s;
    proxy_ignore_headers Cache-Control Expires Set-Cookie Vary X-Accel-Expires
                         X-Accel-Redirect X-Accel-Limit-Rate X-Accel-Buffering
                         X-Accel-Charset;
}

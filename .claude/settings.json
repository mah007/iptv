{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make logs*)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make fmt*)",
      "Bash(make typecheck*)",
      "Bash(make migrate*)",
      "Bash(make seed*)",
      "Bash(make sample-media*)",
      "Bash(make api-client*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv run python manage.py check*)",
      "Bash(uv run python manage.py makemigrations*)",
      "Bash(uv run python manage.py showmigrations*)",
      "Bash(uv run python manage.py spectacular*)",
      "Bash(pnpm install*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm build*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(python3 .claude/skills/dep-check/scripts/dep_check.py*)"
    ],
    "ask": [
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose * down -v*)",
      "Bash(make restore*)",
      "Bash(make deploy*)",
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(git reset --hard*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{ f=$(jq -r '.tool_response.filePath // .tool_input.file_path // empty'); d=\"$CLAUDE_PROJECT_DIR\"; case \"$f\" in \"$d\"/backend/*.py) [ -x \"$d/backend/.venv/bin/ruff\" ] && \"$d/backend/.venv/bin/ruff\" format --force-exclude --quiet \"$f\" ;; \"$d\"/frontend/*.ts|\"$d\"/frontend/*.tsx|\"$d\"/frontend/*.css|\"$d\"/frontend/*.json|\"$d\"/frontend/*.js) [ -x \"$d/frontend/node_modules/.bin/prettier\" ] && cd \"$d/frontend\" && ./node_modules/.bin/prettier --write --log-level silent \"$f\" ;; esac ; } >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  }
}

# Smart IPTV environment template.
# `make secrets` copies it to .env, replacing every __GENERATE__ (hex) and
# __GENERATE_FERNET__ (Fernet key) with a random value; on an existing .env it
# only appends missing keys. Never commit .env; production uses Docker secrets
# or SOPS (SPEC §11).

# --- Routing ------------------------------------------------------------------
# Public hosts are app., api., tv. and admin. under DOMAIN (dev: *.localhost).
DOMAIN=localhost
# Host port Traefik listens on. `make secrets` picks 8080 if 80 is taken.
HTTP_PORT=80
APP_VERSION=0.1.0-dev
# Production only: the Xtream host IPTV apps use, when it isn't tv.<DOMAIN> (the
# installer sets it to the base name itself), and the Let's Encrypt contact address.
# TV_HOST=tv.example.com
# ACME_EMAIL=ops@example.com

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=__GENERATE__
DJANGO_LOG_LEVEL=INFO
# Log format: json (production default) or console (development default).
# DJANGO_LOG_FORMAT=json
# Where browsers load the admin SPA and portal, for CSRF origin checks (ADR-0004).
# Defaults: dev uses http on HTTP_PORT; production uses https on 443.
# PUBLIC_SCHEME=https
# PUBLIC_PORT=443

# --- Field encryption -----------------------------------------------------------
# Fernet key for secrets stored in the database, such as admin TOTP seeds (M3).
FIELD_ENCRYPTION_KEY=__GENERATE_FERNET__

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iptv
POSTGRES_USER=iptv
POSTGRES_PASSWORD=__GENERATE__

# --- Valkey (Redis-compatible) --------------------------------------------------
# redis-state: noeviction + AOF (sessions, slots, broker). redis-cache: LRU.
REDIS_STATE_HOST=redis-state
REDIS_STATE_PASSWORD=__GENERATE__
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD=__GENERATE__
REDIS_CACHE_MAXMEMORY=256mb

# --- Meilisearch ----------------------------------------------------------------
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=__GENERATE__

# --- Media (ADR-0009) -------------------------------------------------------------
# Host folder holding the libraries, mounted read-only at /media in production
# (dev mounts ./media, which `make sample-media` fills). Libraries are folders under it.
# MEDIA_ROOT=/srv/media
# inotify sees nothing on network shares (NFS, SMB): set true to poll them instead.
# LIBRARY_WATCHER_POLLING=false
# Public base URL of the media edge, when it differs from <scheme>://media.<DOMAIN>.
# MEDIA_BASE_URL=https://media.example.com

# --- Xtream contract checks (compat/, make compat-live and make e2e-iptvnator) ---------
# The test account the live checks sign in as; make secrets fills both (the user
# compat-check and a random password). The checks create or update it themselves.
COMPAT_XC_USER=
COMPAT_XC_PASS=

# --- Transcoding (ADR-0010) --------------------------------------------------------
# Dev GPU overlays for the transcoder (make up): nvidia, intel or nvidia,intel. Empty
# (the default, and every server without a GPU): libx264 on the CPU.
# GPU=
# Host group ids that may open /dev/dri (getent group render video), for GPU=intel.
# RENDER_GID=992
# VIDEO_GID=44
# Jobs one transcoder runs at once; attempts before a job fails; first retry delay.
# TRANSCODER_CONCURRENCY=1
# TRANSCODE_MAX_ATTEMPTS=3
# TRANSCODE_RETRY_BACKOFF_S=60

# --- Metadata (TMDB, SPEC §7.2) ---------------------------------------------------
# Without a credential, metadata comes from offline synthetic fixtures (labelled
# synthetic in the admin). A TMDB v4 read access token is preferred over a v3 key.
# TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=

# --- Email (SPEC §7.7, ADR-0012) -------------------------------------------------------
# SMTP for notifications. Dev sends to Mailpit (mailpit:1025, UI at http://mail.<DOMAIN>)
# without any of these. In production, set EMAIL_HOST; until then messages wait in the
# outbox (visible in the admin) and go out once it is set.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# Also sent to Alertmanager as a Docker secret (monitoring overlay); keep the line.
EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=Smart IPTV <no-reply@example.com>

# --- Payment providers (SPEC §7.6, ADR-0012) -------------------------------------------
# Test keys use each provider's sandbox. A provider is offered once its keys are set and
# its billing.<provider>_enabled setting is switched on in the admin. Point its webhook
# at https://api.<DOMAIN>/api/v1/webhooks/<stripe|moyasar>.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MOYASAR_SECRET_KEY=sk_test_...
# MOYASAR_WEBHOOK_SECRET=

# --- Monitoring overlay (SPEC §14, ADR-0018) -------------------------------------------
# Opt-in: MONITORING=1 here (or `make up MONITORING=1`) adds Prometheus, Grafana, Loki,
# Alloy, Alertmanager and the exporters. Grafana, /prometheus and /alertmanager live on
# grafana.<DOMAIN>, reached by signing in to the admin (MFA, permission monitoring.view).
# MONITORING=
# Generated: Grafana's built-in admin (never used to sign in) and the read-only
# PostgreSQL role the exporter uses.
GRAFANA_ADMIN_PASSWORD=__GENERATE__
POSTGRES_MONITOR_PASSWORD=__GENERATE__
# Where alerts go: email recipients (comma-separated; SMTP is the EMAIL_* settings
# above; dev sends to Mailpit) and a Telegram bot and chat. Empty values turn a channel
# off. See docs/runbooks/alerts.md.
ALERT_EMAIL_TO=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Optional dead man's switch: a URL the always-firing Watchdog alert is posted to every
# 5 minutes (e.g. a self-hosted Uptime Kuma push monitor). Empty: off.
ALERT_WATCHDOG_URL=
# The media edge's uplink in Mbit/s; EdgeEgressHigh fires above 80% of it.
# EDGE_CAPACITY_MBPS=1000
# The monitoring-ingress network and Traefik's fixed address on it, which Grafana trusts
# for the sign-in headers (outside the range Docker hands out to the other members).
# Change them together, only if the subnet clashes with another network.
# MONITORING_INGRESS_SUBNET=172.31.254.0/28
# MONITORING_INGRESS_RANGE=172.31.254.8/29
# MONITORING_INGRESS_TRAEFIK_IP=172.31.254.2

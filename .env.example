# Smart IPTV environment template.
# `make secrets` copies it to .env, replacing every __GENERATE__ (hex) and
# __GENERATE_FERNET__ (Fernet key) with a random value; on an existing .env it
# only appends missing keys. Never commit .env; production uses Docker secrets
# or SOPS (SPEC §11).

# --- Routing ------------------------------------------------------------------
# Public hosts are app., api., tv. and admin. under DOMAIN (dev: *.localhost).
DOMAIN=localhost
# Host port Traefik listens on. `make secrets` picks 8080 if 80 is taken.
HTTP_PORT=80
APP_VERSION=0.1.0-dev

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=__GENERATE__
DJANGO_LOG_LEVEL=INFO
# Log format: json (production default) or console (development default).
# DJANGO_LOG_FORMAT=json
# Where browsers load the admin SPA and portal, for CSRF origin checks (ADR-0004).
# Defaults: dev uses http on HTTP_PORT; production uses https on 443.
# PUBLIC_SCHEME=https
# PUBLIC_PORT=443

# --- Field encryption -----------------------------------------------------------
# Fernet key for secrets stored in the database, such as admin TOTP seeds (M3).
FIELD_ENCRYPTION_KEY=__GENERATE_FERNET__

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iptv
POSTGRES_USER=iptv
POSTGRES_PASSWORD=__GENERATE__

# --- Valkey (Redis-compatible) --------------------------------------------------
# redis-state: noeviction + AOF (sessions, slots, broker). redis-cache: LRU.
REDIS_STATE_HOST=redis-state
REDIS_STATE_PASSWORD=__GENERATE__
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD=__GENERATE__
REDIS_CACHE_MAXMEMORY=256mb

# --- Meilisearch ----------------------------------------------------------------
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=__GENERATE__

# --- Media (ADR-0009) -------------------------------------------------------------
# Host folder holding the libraries, mounted read-only at /media in production
# (dev mounts ./media, which `make sample-media` fills). Libraries are folders under it.
# MEDIA_ROOT=/srv/media
# inotify sees nothing on network shares (NFS, SMB): set true to poll them instead.
# LIBRARY_WATCHER_POLLING=false
# Public base URL of the media edge, when it differs from <scheme>://media.<DOMAIN>.
# MEDIA_BASE_URL=https://media.example.com

# --- Transcoding (ADR-0010) --------------------------------------------------------
# Dev GPU overlays for the transcoder (make up): nvidia, intel or nvidia,intel. Empty
# (the default, and every server without a GPU): libx264 on the CPU.
# GPU=
# Host group ids that may open /dev/dri (getent group render video), for GPU=intel.
# RENDER_GID=992
# VIDEO_GID=44
# Jobs one transcoder runs at once; attempts before a job fails; first retry delay.
# TRANSCODER_CONCURRENCY=1
# TRANSCODE_MAX_ATTEMPTS=3
# TRANSCODE_RETRY_BACKOFF_S=60

# --- Metadata (TMDB, SPEC §7.2) ---------------------------------------------------
# Without a credential, metadata comes from offline synthetic fixtures (labelled
# synthetic in the admin). A TMDB v4 read access token is preferred over a v3 key.
# TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=

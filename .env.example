# Smart IPTV environment template.
# `make secrets` copies it to .env, replacing every __GENERATE__ (hex) and
# __GENERATE_FERNET__ (Fernet key) with a random value; on an existing .env it
# only appends missing keys. Never commit .env; production uses Docker secrets
# or SOPS (SPEC §11).

# --- Routing ------------------------------------------------------------------
# Public hosts are app., api., tv. and admin. under DOMAIN (dev: *.localhost).
DOMAIN=localhost
# Host port Traefik listens on. `make secrets` picks 8080 if 80 is taken.
HTTP_PORT=80
APP_VERSION=0.1.0-dev

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=__GENERATE__
DJANGO_LOG_LEVEL=INFO
# Log format: json (production default) or console (development default).
# DJANGO_LOG_FORMAT=json
# Where browsers load the admin SPA and portal, for CSRF origin checks (ADR-0004).
# Defaults: dev uses http on HTTP_PORT; production uses https on 443.
# PUBLIC_SCHEME=https
# PUBLIC_PORT=443

# --- Field encryption -----------------------------------------------------------
# Fernet key for secrets stored in the database, such as admin TOTP seeds (M3).
FIELD_ENCRYPTION_KEY=__GENERATE_FERNET__

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iptv
POSTGRES_USER=iptv
POSTGRES_PASSWORD=__GENERATE__

# --- Valkey (Redis-compatible) --------------------------------------------------
# redis-state: noeviction + AOF (sessions, slots, broker). redis-cache: LRU.
REDIS_STATE_HOST=redis-state
REDIS_STATE_PASSWORD=__GENERATE__
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD=__GENERATE__
REDIS_CACHE_MAXMEMORY=256mb

# --- Meilisearch ----------------------------------------------------------------
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=__GENERATE__

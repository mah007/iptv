# Smart IPTV environment template.
# `make secrets` copies it to .env, replacing every __GENERATE__ (hex) and
# __GENERATE_FERNET__ (Fernet key) with a random value; on an existing .env it
# only appends missing keys. Never commit .env; production uses Docker secrets
# or SOPS (SPEC §11).
#
# .env is for bootstrap only (ADR-0019): hosts, folders and the passwords of the data
# stores. Integrations (TMDB, email, payments, Telegram), branding and every other
# setting are edited in the admin: Settings and Settings → Integrations. The commented
# variables marked "fallback" below are read only until the admin stores a value.

# --- Routing ------------------------------------------------------------------
# Public hosts are app., api., tv. and admin. under DOMAIN (dev: *.localhost).
DOMAIN=localhost
# Host port Traefik listens on. `make secrets` picks 8080 if 80 is taken.
HTTP_PORT=80
APP_VERSION=0.1.0-dev
# Production only: the Xtream host IPTV apps use, when it isn't tv.<DOMAIN> (the
# installer sets it to the base name itself), and the Let's Encrypt contact address.
# TV_HOST=tv.example.com
# ACME_EMAIL=ops@example.com

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=__GENERATE__
# During a key rotation (scripts/rotate-keys.sh secret-key): the previous key, which still
# verifies sessions and password links until the rotation is finished. Empty otherwise.
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_LOG_LEVEL=INFO
# Log format: json (production default) or console (development default).
# DJANGO_LOG_FORMAT=json
# Where browsers load the admin SPA and portal, for CSRF origin checks (ADR-0004).
# Defaults: dev uses http on HTTP_PORT; production uses https on 443.
# PUBLIC_SCHEME=https
# PUBLIC_PORT=443

# --- Field encryption -----------------------------------------------------------
# Fernet key for secrets stored in the database: admin TOTP seeds and the secret
# settings (SMTP password, TMDB token, payment keys...). Back it up with this file:
# without it those secrets must be entered again.
FIELD_ENCRYPTION_KEY=__GENERATE_FERNET__

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iptv
POSTGRES_USER=iptv
POSTGRES_PASSWORD=__GENERATE__
# Separate roles (G-37, ADR-0020): the owner above runs only migrations and one-shot
# jobs; the app services sign in as iptv_app (rows only, no schema changes, an
# append-only audit log); iptv_reporting is read-only, for your own reports.
POSTGRES_APP_PASSWORD=__GENERATE__
POSTGRES_REPORTING_PASSWORD=__GENERATE__
# The read replica's streaming role (M15, ADR-0022; docker/compose.replica.yml).
POSTGRES_REPLICATION_PASSWORD=__GENERATE__
# WAL is archived at least this often, in seconds: the most data a restore can lose.
# PG_ARCHIVE_TIMEOUT=300

# --- Valkey (Redis-compatible) --------------------------------------------------
# redis-state: noeviction + AOF (sessions, slots, broker). redis-cache: LRU.
REDIS_STATE_HOST=redis-state
REDIS_STATE_PASSWORD=__GENERATE__
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD=__GENERATE__
REDIS_CACHE_MAXMEMORY=256mb
# The passwords above are the operator's (`default` user). The app services sign in as
# `app`, which may not run FLUSHALL, FLUSHDB, CONFIG, DEBUG, MODULE or KEYS; the
# monitoring overlay's exporter as `exporter` (G-38, ADR-0020).
REDIS_STATE_APP_PASSWORD=__GENERATE__
REDIS_CACHE_APP_PASSWORD=__GENERATE__
REDIS_STATE_EXPORTER_PASSWORD=__GENERATE__
REDIS_CACHE_EXPORTER_PASSWORD=__GENERATE__
# redis-state never evicts: at this size it refuses writes (alert at 80%) instead of
# letting the host run out of memory (G-35).
REDIS_STATE_MAXMEMORY=1gb

# --- Meilisearch ----------------------------------------------------------------
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=__GENERATE__

# --- Media (ADR-0009) -------------------------------------------------------------
# Host folder holding the libraries, mounted read-only at /media in production
# (dev mounts ./media, which `make sample-media` fills). Libraries are folders under it.
# MEDIA_ROOT=/srv/media
# Fallback of the admin setting library.watcher_polling (for network shares).
# LIBRARY_WATCHER_POLLING=false
# Public base URL of the media edge, when it differs from <scheme>://media.<DOMAIN>.
# MEDIA_BASE_URL=https://media.example.com

# --- Xtream contract checks (compat/, make compat-live and make e2e-iptvnator) ---------
# The test account the live checks sign in as; make secrets fills both (the user
# compat-check and a random password). The checks create or update it themselves.
COMPAT_XC_USER=
COMPAT_XC_PASS=

# --- Transcoding (ADR-0010) --------------------------------------------------------
# Dev GPU overlays for the transcoder (make up): nvidia, intel or nvidia,intel. Empty
# (the default, and every server without a GPU): libx264 on the CPU.
# GPU=
# Host group ids that may open /dev/dri (getent group render video), for GPU=intel.
# RENDER_GID=992
# VIDEO_GID=44
# Jobs one transcoder runs at once (its pool size, fixed at start).
# TRANSCODER_CONCURRENCY=1
# Fallbacks of the admin settings library.transcode_max_attempts and
# library.transcode_retry_backoff_s.
# TRANSCODE_MAX_ATTEMPTS=3
# TRANSCODE_RETRY_BACKOFF_S=60

# --- Metadata (TMDB, SPEC §7.2) ---------------------------------------------------
# Set in the admin: Settings → Integrations → TMDB (and TheTVDB). These are only
# fallbacks for servers set up before that; "Move into settings" copies them in.
# TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
# THETVDB_API_KEY=

# --- Email (SPEC §7.7, ADR-0012) -------------------------------------------------------
# Set in the admin: Settings → Integrations → Email (with a test email). These are only
# fallbacks for servers set up before that. Dev sends to Mailpit (mailpit:1025, UI at
# http://mail.<DOMAIN>) without any of these. Until an SMTP server is set, messages wait
# in the outbox (visible in the admin) and go out once it is.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# Also sent to Alertmanager as a Docker secret (monitoring overlay); keep the line.
EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=Smart IPTV <no-reply@example.com>

# --- Payment providers (SPEC §7.6, ADR-0012) -------------------------------------------
# Set in the admin: Settings → Integrations → Stripe / Moyasar (keys, the on/off switch,
# the webhook URL to copy and a key check). These are only fallbacks.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MOYASAR_SECRET_KEY=sk_test_...
# MOYASAR_WEBHOOK_SECRET=

# --- Monitoring overlay (SPEC §14, ADR-0018) -------------------------------------------
# Opt-in: MONITORING=1 here (or `make up MONITORING=1`) adds Prometheus, Grafana, Loki,
# Alloy, Alertmanager and the exporters. Grafana, /prometheus and /alertmanager live on
# grafana.<DOMAIN>, reached by signing in to the admin (MFA, permission monitoring.view).
# MONITORING=
# Generated: Grafana's built-in admin (never used to sign in) and the read-only
# PostgreSQL role the exporter uses.
GRAFANA_ADMIN_PASSWORD=__GENERATE__
POSTGRES_MONITOR_PASSWORD=__GENERATE__
# Alertmanager hands every alert to Django with this shared secret; Django sends it to
# the recipients and the Telegram chat set in the admin (Settings, Monitoring).
ALERT_WEBHOOK_TOKEN=__GENERATE__
# Alertmanager's own fallback for the alerts about web itself being down uses the admin's
# settings too (recipients: Settings → Monitoring; SMTP and Telegram: → Integrations),
# fetched from Django every minute (ADR-0019). These three apply only until that first
# fetch, on servers set up before it. See docs/runbooks/alerts.md.
ALERT_EMAIL_TO=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Optional dead man's switch: a URL the always-firing Watchdog alert is posted to every
# 5 minutes (e.g. a self-hosted Uptime Kuma push monitor). Empty: off.
ALERT_WATCHDOG_URL=
# The monitoring-ingress network and Traefik's fixed address on it, which Grafana trusts
# for the sign-in headers (outside the range Docker hands out to the other members).
# Change them together, only if the subnet clashes with another network.
# MONITORING_INGRESS_SUBNET=172.31.254.0/28
# MONITORING_INGRESS_RANGE=172.31.254.8/29
# MONITORING_INGRESS_TRAEFIK_IP=172.31.254.2

# --- Live TV (M12, ADR-0017) -------------------------------------------------------------
# The catch-up archive's disk budget and the other live TV knobs are admin settings
# (Settings → Live TV), not environment variables.
# Optional ingest for your own encoders and cameras: docker/compose.mediamtx.yml
# (docs/runbooks/live-tv.md). LIVE_INGEST=1 makes scripts/install.sh run it;
# LIVE_INGEST_BIND limits its published ports (RTMP 1935, SRT 8890/udp, RTSP 8554) to
# one host address, such as a LAN or VPN interface (Docker's published ports bypass ufw).
LIVE_INGEST=0
LIVE_INGEST_BIND=0.0.0.0
# Its publish and read users (generated; MediaMTX is a separate process and reads them
# at start).
MEDIAMTX_PUBLISH_USER=publisher
MEDIAMTX_PUBLISH_PASS=__GENERATE__
MEDIAMTX_READ_USER=reader
MEDIAMTX_READ_PASS=__GENERATE__

# --- Backups (M14b, ADR-0020) ------------------------------------------------------------
# The backup service backs up PostgreSQL (pgBackRest, point-in-time recovery), .env,
# secrets/, the artwork and a pg_dump (restic), runs the weekly restore drill and, when
# set, copies everything to an S3-compatible bucket. Schedule, retention and the bucket
# are admin settings (Settings → Backups). Everything is encrypted with
# secrets/backup_passphrase, which scripts/secrets.sh creates once: keep a copy of it
# away from this server, or the backups cannot be read.
# Where backups are kept on this server (production: a host folder, ideally another
# disk; the installer asks). Unset: the backup-repo Docker volume (development).
# BACKUP_DIR=/var/backups/smart-iptv
# The backup service's token for Django's internal API (copied to secrets/runtime/).
BACKUP_AGENT_TOKEN=__GENERATE__

# --- Application security (M14a, ADR-0021) ------------------------------------------------
# The shared secret the media edge and the live relay present to Django's internal
# stream-auth as X-Edge-Auth (G-16; copied to secrets/runtime/edge_auth_token).
EDGE_AUTH_TOKEN=__GENERATE__

# --- CrowdSec (M14b, ADR-0020) -----------------------------------------------------------
# CROWDSEC=1 runs the CrowdSec engine on Traefik's logs and its bouncer in Traefik
# (docker/compose.crowdsec.yml; the installer asks). Enforcement on or off and the
# addresses never blocked are admin settings (Settings → Security).
CROWDSEC=0
# Generated: Traefik's bouncer key for the CrowdSec local API.
CROWDSEC_BOUNCER_KEY=__GENERATE__
# 1: also use CrowdSec's community blocklist, which shares the attacking IPs this server
# sees with CrowdSec. Off unless you opt in.
CROWDSEC_ONLINE=0

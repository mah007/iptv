    {
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Media caching only applies to edges with an S3 origin; local disk shows none.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (edge) (rate(iptv_edge_auth_total{auth_cache=\"HIT\"}[15m])) / sum by (edge) (rate(iptv_edge_auth_total[15m]))",
          "legendFormat": "stream-auth {{edge}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (edge) (rate(iptv_edge_requests_total{cache_status=\"HIT\"}[15m])) / sum by (edge) (rate(iptv_edge_requests_total{cache_status!=\"NONE\"}[15m]))",
          "legendFormat": "media {{edge}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8

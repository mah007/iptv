    {
      "type": "timeseries",
      "title": "Egress per edge and capacity",
      "description": "From the edge container's network counters (real time).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "edge:egress_bits:rate5m",
          "legendFormat": "{{edge}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "iptv:edge_capacity_bits",
          "legendFormat": "capacity",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }

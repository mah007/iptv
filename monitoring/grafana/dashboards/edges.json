    },
    {
      "type": "timeseries",
      "title": "Request time p95 (playlists and segments, TTFB proxy)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(iptv_edge_request_duration_seconds_bucket{kind=~\"playlist|segment\"}[5m])))",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
